FROM python:3.12.3

WORKDIR /app

COPY requirements.txt /app/

# Run cron in Eswatini local time so crontab entries read as wall-clock
# local (SAST, UTC+2) — the observer reminder is scheduled for 07:00 local.
ENV TZ=Africa/Mbabane
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

#Install Cron
RUN apt-get update
RUN apt-get -y install cron tzdata

RUN set -e; \
    pip -q install --upgrade pip && \
    pip -q install --no-cache-dir -r requirements.txt && \
    pip check

copy . /app/

# Add the cron job
RUN crontab /app/eswatini-cron

# Create the log file to be able to run tail
RUN touch /app/cron.log

CMD cron && tail -f /app/cron.log