# ==============================================================================
# Eswatini Droughtmap Hub Configuration Template (.env)
# Copy this file to '.env' and fill in your local values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django & General Core Settings
# ------------------------------------------------------------------------------
SECRET_KEY="secret"

# ------------------------------------------------------------------------------
# 2. GeoNode Integration
# External GeoNode instance base URL and admin credentials for fetching CDI raster datasets
# ------------------------------------------------------------------------------
GEONODE_BASE_URL="https://geonode.akvotest.org"
GEONODE_ADMIN_USERNAME="youradminusernameoremail"
GEONODE_ADMIN_PASSWORD="youradminpassword"

# ------------------------------------------------------------------------------
# 3. Email Notification & SMTP Settings
# Used for system notifications and overdue review alerts
# ------------------------------------------------------------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER="your-email@example.com"
EMAIL_HOST_PASSWORD="your-email-password"
EMAIL_FROM="noreply@example.com"

# ------------------------------------------------------------------------------
# 4. Networking & Routing Settings
# ------------------------------------------------------------------------------
# Web domain of the Next.js frontend application
WEBDOMAIN="http://localhost:3000"

# Direct backend service URL for server-side calls (bypasses Next.js proxy)
BACKEND_URL="http://127.0.0.1:8000"

# Trusted origins for Django CSRF verification protection
CSRF_TRUSTED_ORIGINS="http://localhost:3000"

# Frontend Next.js session encryption secret
SESSION_SECRET="secret"

# ------------------------------------------------------------------------------
# 5. Rundeck Automation Integration
# API configuration for Rundeck background tasks and job triggers
# ------------------------------------------------------------------------------
RUNDECK_API_URL="http://localhost:4440/api/49"
RUNDECK_API_TOKEN="secret"

# ------------------------------------------------------------------------------
# 6. Indigenous Knowledge Systems (IKS) API Settings
# Custom shared secret validated via HTTP X-API-Key header to trigger monthly data syncs
# ------------------------------------------------------------------------------
X_API_KEY="your-secret-x-api-key"